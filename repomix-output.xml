<file path="src/utils/date.js">
const pad = (n) => String(n).padStart(2, '0');
const toYMD = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

function monthRange(d = new Date()) {
  return {
    from: toYMD(new Date(d.getFullYear(), d.getMonth(), 1)),
    to: toYMD(new Date(d.getFullYear(), d.getMonth() + 1, 0)),
  };
}

// Week runs Monday..Sunday
function weekRange(d = new Date()) {
  const day = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  const start = new Date(day);
  start.setDate(day.getDate() - ((day.getDay() + 6) % 7));
  const end = new Date(start);
  end.setDate(start.getDate() + 6);
  return { from: toYMD(start), to: toYMD(end) };
}

function shiftDays(d, n) {
  const x = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  x.setDate(x.getDate() + n);
  return x;
}

module.exports = { toYMD, monthRange, weekRange, shiftDays };
</file>

<file path="src/utils/errors.js">
class ValidationError extends Error {
  constructor(errors) {
    super(errors.join('; '));
    this.errors = errors;   // array of Indonesian messages
    this.status = 400;
    this.expose = true;
  }
}
module.exports = { ValidationError };
</file>

<file path="src/utils/format.js">
const nf = new Intl.NumberFormat('id-ID');
const rupiah = (n) => 'Rp ' + nf.format(n);
const dateID = (ymd) => { const [y, m, d] = ymd.split('-'); return `${d}/${m}/${y}`; };
module.exports = { rupiah, dateID };
</file>

<file path="src/utils/hash.js">
const crypto = require('crypto');

// `occurrence` = n-th identical row inside the same document (0, 1, 2...).
// This keeps two real purchases of the same amount on the same day from being treated as duplicates,
// while re-importing the same document still matches row by row.
function makeDedupeHash({ accountId, date, type, amount, description }, occurrence = 0) {
  const norm = String(description).toLowerCase().replace(/\s+/g, ' ').trim();
  return crypto.createHash('sha256').update([accountId, date, type, amount, norm, occurrence].join('|')).digest('hex');
}
module.exports = { makeDedupeHash };
</file>

<file path="src/utils/parse.js">
// "15.000", "Rp 15.000", "15000" -> 15000. Returns null when invalid.
function parseAmount(raw) {
  const str = String(raw ?? '').trim();
  const negative = str.startsWith('-') || str.startsWith('(');
  let s = str.replace(/[^\d.,]/g, '');
  s = s.replace(/[.,]\d{1,2}$/, '');   // drop decimals like ",00" (rupiah has none)
  s = s.replace(/[.,]/g, '');          // drop thousand separators
  if (!s) return null;
  const n = Number(s);
  return Number.isFinite(n) ? (negative ? -n : n) : null;
}

// Accepts YYYY-MM-DD, DD/MM/YYYY, DD-MM-YYYY. Returns 'YYYY-MM-DD' or null.
function parseDate(raw) {
  const s = String(raw ?? '').trim();
  let m;
  let y; let mo; let d;
  if ((m = s.match(/^(\d{4})-(\d{2})-(\d{2})/))) { y = +m[1]; mo = +m[2]; d = +m[3]; }
  else if ((m = s.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})/))) { d = +m[1]; mo = +m[2]; y = +m[3]; }
  else return null;
  const dt = new Date(y, mo - 1, d);
  if (dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) return null;
  return `${y}-${String(mo).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
}
module.exports = { parseAmount, parseDate };
</file>

<file path="src/app.js">
const express = require('express');
const path = require('path');
const helmet = require('helmet');
const config = require('./config');

function createApp() {
  const app = express();
  if (config.trustProxy) app.set('trust proxy', config.trustProxy);
  app.set('view engine', 'ejs');
  app.set('views', path.join(config.root, 'views'));

  const secureTransport = config.https || config.trustProxy > 0;
  app.use(helmet({
    contentSecurityPolicy: {
      directives: {
        'upgrade-insecure-requests': secureTransport ? [] : null,
      },
    },
    hsts: secureTransport,
  }));
  app.use(express.urlencoded({ extended: false }));
  app.use(express.json({ limit: '100kb' }));
  app.use(express.static(path.join(config.root, 'public')));
  app.locals.rupiah = require('./utils/format').rupiah;
  app.locals.dateID = require('./utils/format').dateID;

  app.get('/health', (req, res) => res.send('ok'));

  const { setupGuard, requireAuth } = require('./middleware/auth');
  const { notFound, errorHandler } = require('./middleware/errors');

  app.use(require('./config/session'));
  app.use(require('./middleware/csrf'));
  app.use(require('./middleware/flash'));
  app.use(setupGuard);
  app.use(require('./routes/auth'));
  app.use(requireAuth);
  app.use(require('./routes'));
  app.use(notFound);
  app.use(errorHandler);
  return app;
}

module.exports = createApp;
</file>

