<%- include('../partials/head', { title: 'Kategori' }) %>
<h1>Kategori</h1>

<% if (errors && errors.length) { %>
  <ul class="flash flash-error">
    <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
  </ul>
<% } %>

<% ['income', 'expense'].forEach(function (kind) { %>
  <h2><%= kind === 'income' ? 'Pemasukan' : 'Pengeluaran' %></h2>
  <% var group = categories.filter(function (c) { return c.kind === kind; }); %>
  <% if (!group.length) { %>
    <p class="empty">Belum ada kategori <%= kind === 'income' ? 'pemasukan' : 'pengeluaran' %>.</p>
  <% } else { %>
    <% group.forEach(function (c) { %>
      <div class="card">
        <form method="post" action="/categories/<%= c.id %>" class="row">
          <%- include('../partials/csrf') %>
          <label>Nama <input name="name" value="<%= c.name %>" required></label>
          <button type="submit" class="secondary">Simpan</button>
        </form>
        <form method="post" action="/categories/<%= c.id %>/delete" data-confirm="Hapus kategori ini?">
          <%- include('../partials/csrf') %>
          <button type="submit" class="danger small">Hapus</button>
        </form>
      </div>
    <% }) %>
  <% } %>
<% }) %>

<h2>Tambah kategori</h2>
<form method="post" action="/categories" class="card narrow">
  <%- include('../partials/csrf') %>
  <label>Nama <input name="name" value="<%= form.name || '' %>" required></label>
  <label>Jenis
    <select name="kind">
      <option value="expense">Pengeluaran</option>
      <option value="income">Pemasukan</option>
    </select>
  </label>
  <button type="submit">Simpan</button>
</form>
<script src="/js/confirm-delete.js" defer></script>
<%- include('../partials/foot') %>
